# Warden Environment Configuration
WARDEN_ENV_NAME=moneycast
WARDEN_ENV_TYPE=laravel
WARDEN_WEB_ROOT=/

# Traefik Domain Configuration
TRAEFIK_DOMAIN=moneycast.local
TRAEFIK_SUBDOMAIN=

# Database Configuration (PHP 8.4)
WARDEN_DB=1
WARDEN_DB_ENGINE=postgres

# Redis Configuration
WARDEN_REDIS=1

# Elasticsearch/OpenSearch (disabled, using Meilisearch instead)
WARDEN_ELASTICSEARCH=0
WARDEN_OPENSEARCH=0

# RabbitMQ (disabled)
WARDEN_RABBITMQ=0

# Varnish (disabled)
WARDEN_VARNISH=0

# Mailhog Configuration
WARDEN_MAILHOG=1

# Allure (disabled)
WARDEN_ALLURE=0

# Blackfire (disabled for dev)
WARDEN_BLACKFIRE=0

# SplitDNS Configuration
WARDEN_SPLIT_SALES=
WARDEN_SPLIT_ADMIN=

# Sync Configuration (Mutagen for macOS performance)
WARDEN_SYNC_IGNORE=

# Test Domain
WARDEN_TEST_DB=moneycast_test

# Environment Indicator
WARDEN_ENV_SUBT=

# Laravel Application Configuration
APP_NAME=MoneyCast
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=https://moneycast.local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (Warden PostgreSQL/Supabase)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=moneycast
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Session Configuration
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=moneycast.local
SESSION_SECURE_COOKIE=true

# Broadcasting & Filesystem
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Queue Configuration (Redis)
QUEUE_CONNECTION=redis

# Cache Configuration (Redis)
CACHE_STORE=redis
CACHE_PREFIX=

# Redis Configuration (Warden)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=devpassword
REDIS_PORT=6379

# Mail Configuration (Mailhog)
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@moneycast.local"
MAIL_FROM_NAME="${APP_NAME}"

# AWS (not used in dev)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Vite Configuration
VITE_APP_NAME="${APP_NAME}"
VITE_DEV_SERVER_URL=https://moneycast.local:5173

# Meilisearch Configuration
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=masterKey123

# Supabase Configuration
POSTGRES_PASSWORD=postgres
POSTGRES_DB=moneycast

# JWT Configuration for Supabase Auth
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600

# Supabase API Keys (generated from JWT_SECRET)
# These are example keys - in production, generate proper keys
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# Supabase URLs
API_EXTERNAL_URL=https://supabase.moneycast.local
SUPABASE_PUBLIC_URL=https://supabase.moneycast.local
SITE_URL=https://moneycast.local

# Email Configuration for Supabase Auth
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
DISABLE_SIGNUP=false
SMTP_ADMIN_EMAIL=admin@moneycast.local
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=MoneyCast
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# Phone Authentication (disabled for now)
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

# Supabase Studio Configuration
STUDIO_DEFAULT_ORGANIZATION=MoneyCast
STUDIO_DEFAULT_PROJECT=MoneyCast Development

# Dashboard Access
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=supabase

# PostgREST Configuration
PGRST_DB_SCHEMAS=public,storage,graphql_public

# Logflare Analytics
LOGFLARE_API_KEY=your-super-secret-and-long-logflare-key

# Image Proxy
IMGPROXY_ENABLE_WEBP_DETECTION=true

# Functions
FUNCTIONS_VERIFY_JWT=false

# Docker Socket (for Vector log collection)
DOCKER_SOCKET_LOCATION=/var/run/docker.sock

# Laravel Supabase Integration
SUPABASE_URL=https://supabase.moneycast.local
SUPABASE_ANON_KEY=${ANON_KEY}
SUPABASE_SERVICE_ROLE_KEY=${SERVICE_ROLE_KEY}
