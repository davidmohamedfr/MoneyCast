# Docker Environment Configuration
# ⚠️  DO NOT use this file directly - it contains placeholders!
# ✅ Run 'make install' to automatically generate secure random passwords
# 📋 Or manually copy to .env and replace CHANGE_ME_GENERATE_RANDOM_PASSWORD values

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Database (PostgreSQL via Docker - Supabase image)
# ⚠️  WARNING: These are DEVELOPMENT-ONLY credentials
# 🚨 NEVER use in production - Run ./docker/scripts/generate-env.sh for secure random credentials
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=moneycast
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_GENERATE_RANDOM_PASSWORD

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Session (Redis via Docker)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Queue (Redis via Docker)
QUEUE_CONNECTION=redis

# Cache (Redis via Docker)
CACHE_STORE=redis

MEMCACHED_HOST=127.0.0.1

# Redis (Docker container)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_GENERATE_RANDOM_PASSWORD
REDIS_PORT=6379

# Mail (Development)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
